<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jika file/folder yang diminta ada, layani langsung
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Selain itu, arahkan ke index.html (SPA fallback untuk react-router)
  RewriteRule ^ index.html [L]
</IfModule>
